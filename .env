# ===================================================================
# Mind Trace - Production Development Environment
# ===================================================================
# Clean configuration with intentional local fallbacks

# --- Frontend Variables (Vite - must start with VITE_) ---
VITE_PORT=5173
VITE_BASE_PATH=/
VITE_BASE_URL=http://localhost:5173
VITE_NODE_ENV=development
VITE_LOG_LEVEL=error
VITE_REPL_ID=dev-repl-001

# --- Authentication (Frontend) ---
# Set real Clerk keys to enable production auth, otherwise uses local auth
VITE_CLERK_PUBLISHABLE_KEY=pk_test_disabled
VITE_CLERK_PROXY_URL=

# --- Analytics (Frontend) ---
# Set real GA keys to enable production analytics, otherwise uses local tracking
VITE_ANALYTICS_ID=disabled

# --- Database (Frontend - for validation only) ---
# Set real PostgreSQL URL to enable external database, otherwise uses localStorage
VITE_DATABASE_URL=local
VITE_CLERK_SECRET_KEY=sk_test_disabled

# --- Backend Variables (Node.js - process.env) ---
CLERK_SECRET_KEY=sk_test_disabled
DATABASE_URL=local
NODE_ENV=development
LOG_LEVEL=error
PORT=3001
BASE_PATH=/

# ===================================================================
# SYSTEM MODE: development-local
# All systems functional with local fallbacks
# ===================================================================
