# ===================================================================
# Mind Trace Environment Configuration (Complete)
# ===================================================================
# This file covers ALL environment variables found in the codebase
# Frontend variables must start with VITE_ (Vite requirement)
# Backend variables use process.env (Node.js requirement)

# --- Frontend Variables (Vite - must start with VITE_) ---
VITE_PORT=5173
VITE_BASE_PATH=/
VITE_BASE_URL=http://localhost:5173
VITE_NODE_ENV=development
VITE_LOG_LEVEL=info
VITE_REPL_ID=dev-repl-001

# --- Clerk Authentication (Frontend) ---
VITE_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_disabled
VITE_CLERK_PROXY_URL=

# --- Analytics (Frontend) ---
VITE_ANALYTICS_ID=disabled

# --- Database (Frontend - for validation only) ---
VITE_DATABASE_URL=local
VITE_CLERK_SECRET_KEY=sk_test_disabled

# --- Optional Third-Party Services (Frontend) ---
VITE_STRIPE_KEY=disabled
VITE_OPENAI_KEY=disabled
VITE_SUPABASE_URL=disabled
VITE_SUPABASE_ANON_KEY=disabled

# --- Feature Flags ---
VITE_ENABLE_CLERK=false
VITE_MOCK_API=true

# --- Backend Variables (Node.js - process.env) ---
# --- Clerk Authentication (Backend) ---
CLERK_SECRET_KEY=sk_test_disabled

# --- Database Configuration (Backend) ---
DATABASE_URL=local

# --- Environment Settings ---
NODE_ENV=development
LOG_LEVEL=info

# --- Server Configuration ---
PORT=3001
BASE_PATH=/

# --- Additional Environment Variables Found ---
REPL_ID=
VITE_REPL_ID=dev-repl-001

# ===================================================================
# INTEGRATION STATUS
# ===================================================================
# Frontend: Uses VITE_ prefixed variables (browser-safe)
# Backend: Uses process.env variables (Node.js)
# Clerk: DISABLED (graceful fallback to mock authentication)
# Database: DISABLED (localStorage persistence mode)
# Analytics: DISABLED (no tracking)
# Stripe: DISABLED (no payment processing)
# OpenAI: DISABLED (no AI features)
# Supabase: DISABLED (no external database)
# ===================================================================
